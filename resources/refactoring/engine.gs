category: 'building'
method: GsRenameInstanceVariableRefactoring
buildChangeSet
	| cs |
	cs := GsRefactoringChangeSet new.
	self stageMethodRecompilesInto: cs.
	self stageClassDefinitionEditInto: cs.
	^cs
